{
	"name": "flarum-lang/marathi",
	"description": "Marathi Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/marathi",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/marathi/issues",
		"forum": "https://discuss.flarum.org/d/40202",
		"source": "https://github.com/flarum-lang/marathi"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Marathi",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "mr",
			"title": "मराठी"
		}
	}
}
